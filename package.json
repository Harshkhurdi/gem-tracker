{
  "name": "government-medical-tender-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch:live": "node --import tsx scripts/live-validation.ts",
    "audit:data": "node --import tsx scripts/audit-data.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "pdf-parse": "2.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "undici": "^7.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
