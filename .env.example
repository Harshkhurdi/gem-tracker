# Optional: enables authenticated forced upstream refresh. Leave empty for cached public reads.
ADMIN_REFRESH_TOKEN=
# Optional: durable last-known-success cache across deployments. Both are needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional secure one-way MedOps discovery handoff (server only).
# Configure separate targets/secrets in each environment; production requires HTTPS.
APP_URL=
MEDOPS_API_URL=
MEDOPS_INTEGRATION_SECRET=
INTEGRATION_ENVIRONMENT=
# Separate PRIVATE Tracker receipt store. Never reuse MedOps's Blob token/store.
BLOB_READ_WRITE_TOKEN=
# Local development only; production never stores receipts on the function filesystem.
MEDOPS_LOCAL_RECEIPT_PATH=.local-receipts
NEXT_TELEMETRY_DISABLED=1
